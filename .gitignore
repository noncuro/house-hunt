node_modules/
.output/
.wxt/
.next/
stats.html

# Saved Rightmove pages for the smoke harness. Not committed: their content is theirs. Globbed
# rather than named as a directory so the exception below can apply — git will not un-ignore a file
# inside a directory it has already excluded.
.fixtures/*

# The exception: the verdict-score fixture is ids, numbers and booleans only — no address, no url,
# no postcode — by construction in `tools/export-predict-fixture.ts`. It is the data `check:predict`
# exists to run on, and a check whose data is untracked is a check that only ever runs on one
# laptop. Commit it.
!.fixtures/predict-*.json

# The admin address and the project name for one deployment. Copy supabase/seed.example.sql to
# this path and edit it; the example is what is committed.
supabase/seed.sql

# Scratch analysis run against real listings.
research/

# Secrets. This rule used to live in the parent repository's .gitignore and did not come with the
# split — for a while this repo would have committed a database password on the first `git add -A`.
# .env.example is the committed template and is deliberately un-ignored.
.env
.env.*
!.env.example
# The placeholder root .env that CI copies into place. Committed on purpose and holds no secret —
# read its header. Needs saying explicitly or the `.env.*` rule above swallows it.
!.env.ci
# Secrets for the locally-served Edge Functions (WEB_APP_ORIGIN, and the OpenAI key if you ever
# serve `analyse`). Its template beside it is committed, and needs saying explicitly or the
# `.env.*` rule above swallows it.
supabase/.env
!supabase/.env.example

# Regenerated by every `next build`.
apps/web/next-env.d.ts

# tsc build info, regenerated on every typecheck.
*.tsbuildinfo
.vercel

# Local agent state: settings, and any git worktrees created under here. The worktrees are whole
# second checkouts (one carried a real .env before this rule), so never vendor them into the repo.
.claude/

# Python bytecode from the tools/ scripts.
__pycache__/
.playwright-mcp/

# Scratch notes and working files for whatever is being built at the time.
.working/
