# Copy to .env and fill in. Only WXT_-prefixed variables reach the extension bundle; anything else
# here stays on your machine and is used by the tools in tools/ and by the Supabase CLI.
#
# The two WXT_ values are safe to ship in a built extension and are meant to be public: the
# publishable key authorises nothing on its own, because every row-level security policy is written
# `to authenticated` and the `anon` role holds no grant on any table. `pnpm check:rls` asserts that.

# Your Supabase project's API URL, e.g. https://abcdefghijkl.supabase.co
WXT_SUPABASE_URL=

# The project's publishable (anon) key.
WXT_SUPABASE_PUBLISHABLE_KEY=

# --- below here: never shipped, used only by tools and deploys ---

# The project ref alone (the subdomain from the URL above). Used by `pnpm deploy:function`.
SUPABASE_PROJECT_REF=

# The database password, for connecting with psql to apply migrations by hand.
SUPABASE_DB_PASSWORD=
