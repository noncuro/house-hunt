{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@house-hunt/ui": ["../../packages/ui/src/index.ts"],
      "@house-hunt/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src", "remotion.config.ts"]
}
