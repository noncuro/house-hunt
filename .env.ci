# The root .env that CI copies into place (`cp .env.ci .env`), and nothing else should use.
#
# It exists because `pnpm install` runs `wxt prepare`, which reads this file and *refuses* when
# WXT_SUPABASE_URL is absent — deliberately, since a missing prefix produces an empty panel rather
# than an error, and that check is worth keeping. On a runner there is no .env at all, so install
# itself failed before any check could run.
#
# Every value points at the local stack the workflow starts, at the CLI's fixed default ports and
# with the CLI's fixed demo keys. Those keys are not secret: they are the same two JWTs in every
# `supabase start` on earth, signed with the published demo secret, and they authorise nothing
# outside a container on the runner. Nothing here reaches the hosted project — that is configured
# in Vercel and in the Supabase dashboard, and this file has no ref, no password and no OpenAI key.
#
# The harnesses do not actually read most of this. `smoke:web` passes NEXT_PUBLIC_* to the build
# itself, and `build:smoke` passes WXT_* to wxt, because which database each surface talks to is
# compiled in and cannot be arranged at runtime. This file is what makes `install` succeed.

WXT_SUPABASE_URL=http://127.0.0.1:54341
WXT_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# The origin `smoke:web` serves the site on, so the extension's bridge trust boundary and the
# functions' CORS agree with where the site actually is. Kept in step with supabase/.env.example.
WXT_WEB_APP_URL=http://127.0.0.1:3199
