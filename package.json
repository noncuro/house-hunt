{
  "name": "house-hunt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "//": "The workspace root. It owns the checks that span packages and the tooling every package shares; each app owns its own build.",
  "scripts": {
    "dev": "pnpm --filter @house-hunt/ext dev",
    "dev:web": "pnpm --filter @house-hunt/web dev",
    "build": "pnpm --filter @house-hunt/ext build",
    "build:web": "pnpm --filter @house-hunt/web build",
    "zip": "pnpm --filter @house-hunt/ext zip",
    "zip:store": "pnpm --filter @house-hunt/ext zip:store",
    "package": "pnpm --filter @house-hunt/ext package",
    "//package": "Vercel builds only apps/web and cannot build the extension, so the download served by the Install tab is a committed asset and `package` writes it directly. There was a second script that copied it into place; nobody ran it, which is how the served zip stayed at 0.1.0 for three versions.",
    "compile": "tsc --noEmit -p apps/extension && tsc --noEmit -p apps/web",
    "lint": "oxlint",
    "check": "oxlint && pnpm compile",
    "sweep": "tsx tools/sweep-runner.ts",
    "sweep:sign-in": "tsx tools/sweep-runner.ts --sign-in",
    "check:one-client": "tsx tools/check-one-client.ts",
    "check:migrations": "tsx tools/check-migrations.ts",
    "check:routes": "tsx tools/check-routes.ts",
    "check:bridge": "tsx tools/check-bridge.ts",
    "check:extractor": "tsx tools/check-extractor.ts",
    "check:withdrawn": "tsx tools/check-withdrawn.ts",
    "check:area": "tsx tools/check-area-parser.ts",
    "check:facts": "tsx tools/check-facts.ts",
    "check:filter": "tsx tools/check-filter.ts",
    "check:listing": "tsx tools/check-listing-url.ts",
    "check:invite": "tsx tools/check-invite.ts",
    "check:platform": "tsx tools/check-platform.ts",
    "check:geo": "tsx tools/check-geo.ts",
    "check:recheck": "tsx tools/check-recheck.ts",
    "check:full-sweep": "tsx tools/check-full-sweep.ts",
    "check:hubs": "tsx tools/check-hubs.ts",
    "check:stage": "tsx tools/check-stage.ts",
    "check:shortlist": "tsx tools/check-shortlist.ts",
    "check:sweep": "tsx tools/check-sweep.ts",
    "check:png": "tsx tools/check-png.ts",
    "check:analysis": "tsx tools/check-analysis.ts",
    "check:predict": "tsx tools/check-predict.ts",
    "check:travel": "tsx tools/check-travel.ts",
    "check:spend": "tsx tools/check-spend.ts",
    "check:rls": "tsx tools/check-rls.ts",
    "check:zip": "tsx tools/check-zip.ts",
    "check:all": "pnpm check && pnpm check:one-client && pnpm check:migrations && pnpm check:routes && pnpm check:bridge && pnpm check:area && pnpm check:facts && pnpm check:filter && pnpm check:listing && pnpm check:invite && pnpm check:platform && pnpm check:geo && pnpm check:hubs && pnpm check:stage && pnpm check:shortlist && pnpm check:sweep && pnpm check:travel && pnpm check:png && pnpm check:analysis && pnpm check:predict && pnpm check:withdrawn && pnpm check:recheck && pnpm check:full-sweep && pnpm check:zip",
    "smoke": "tsx tools/smoke.ts",
    "smoke:search": "tsx tools/smoke-search.ts",
    "smoke:web": "tsx tools/smoke-web.ts",
    "smoke:all": "tsx tools/smoke-all.ts",
    "build:smoke": "tsx tools/build-smoke.ts",
    "icons": "tsx tools/app-icons.ts",
    "find:locations": "tsx tools/find-locations.ts",
    "fixture": "tsx tools/fixture-listing.ts",
    "fixture:search": "tsx tools/fixture-search.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "@types/node": "^26.2.0",
    "oxlint": "^1.77.0",
    "playwright": "^1.49.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.2"
  }
}
