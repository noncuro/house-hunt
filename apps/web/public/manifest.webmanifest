{
  "name": "House hunt",
  "short_name": "House hunt",
  "description": "A shared shortlist for looking at flats in London with somebody else.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#faf8f4",
  "theme_color": "#fdfcfa",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Add a flat",
      "short_name": "Add",
      "description": "Paste a Rightmove listing address into this hunt",
      "url": "/?add=",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Triage",
      "short_name": "Triage",
      "description": "Work through the flats nobody has rated yet",
      "url": "/?v=triage",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
