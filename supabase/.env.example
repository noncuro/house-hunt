# Template for `supabase/.env`, which is untracked because it holds secrets. Copy it:
#
#     cp supabase/.env.example supabase/.env
#
# and then `supabase stop && supabase start` — the local Edge Runtime reads this file once, at
# start, so editing it under a running stack changes nothing.

# The origin the functions will accept as the website. `_shared/http.ts` compares the caller's
# Origin against exactly this string; anything else is answered `Access-Control-Allow-Origin: null`
# and the browser discards the reply.
#
# It is set to the port `smoke:web` serves on rather than the 3100 of `pnpm dev:web`, because the
# harness is the thing that breaks confusingly without it: the website comes up, signs in, renders
# the shortlist, and then spins on "Working…" for every travel time with only a console message to
# say why. Change it to http://127.0.0.1:3100 if you want travel to resolve under `pnpm dev:web`.
WEB_APP_ORIGIN=http://127.0.0.1:3199

# The vision model's key, used only by the `analyse` function. No harness needs it — none of them
# analyse anything — so it can stay empty locally.
OPENAI_API_KEY=
